# Finance Tracker Environment Configuration
# Copy this file to .env and fill in your values

# Database path (default works for Docker container)
DATABASE_PATH=/app/data/options.db

# StockNear Configuration
# Optional. Path to the Firefox/LibreWolf profile containing stocknear.com
# session cookies, AS SEEN FROM INSIDE THE CONTAINER. Contract quotes and
# history are sent with these cookies when present; StockNear's contract API
# answered without them when last checked, so the app works without a
# profile.
#
# When running via run.sh, leave this as the container mount point below.
# run.sh mounts your host profile read-only at /app/browser-profile and
# passes this value with -e, overriding whatever is set here. Point run.sh
# at a different host profile with:
#     BROWSER_PROFILE=/path/to/profile ./run.sh start
#
# Set a host path here only when running the app directly (uv run uvicorn)
# rather than in a container.
# Windows example: C:/Users/YourName/AppData/Roaming/LibreWolf/Profiles/xxxxxxxx.default-default
# WSL example: /mnt/c/Users/YourName/AppData/Roaming/LibreWolf/Profiles/xxxxxxxx.default-default
STOCKNEAR_BROWSER_PROFILE_PATH=/app/browser-profile

# Cache TTL for StockNear data in seconds (default: 3600 = 1 hour)
STOCKNEAR_CACHE_TTL_SECONDS=3600

# Contract-history sync freshness, in seconds (default: 43200 = 12 hours).
# The source publishes once per trading day, so 12 hours fetches each day's
# data about once. Sync is user-triggered from the positions page; this only
# suppresses redundant re-downloads within a run of clicking. Override a skip
# with POST /api/contract-history/sync?force=true
STOCKNEAR_HISTORY_TTL_SECONDS=43200

# StockNear base URL (usually no need to change)
STOCKNEAR_BASE_URL=https://stocknear.com

# StockNear MCP server (symbol-level data: options overview, max pain, quotes)
STOCKNEAR_MCP_URL=https://mcp.stocknear.com/mcp
# Bearer token for the MCP server. Required. Get one from stocknear.com.
# This is a credential — keep it in .env only, never commit a real value.
STOCKNEAR_MCP_TOKEN=
# Request timeout in seconds
STOCKNEAR_MCP_TIMEOUT=30

# Price service cache TTL in seconds (default: 60)
PRICE_CACHE_TTL_SECONDS=60

# Risk math defaults (override if your assumptions differ)
# Risk-free rate as decimal (0.05 = 5%). Used in every Black-Scholes calc.
RISK_FREE_RATE=0.05
# Fallback IV when no live IV is available, as decimal (0.30 = 30%).
# 30% is reasonable for SPY-like names but wildly low for individual stocks.
DEFAULT_VOLATILITY=0.30
# Max simultaneous in-flight MCP requests
STOCKNEAR_MCP_MAX_CONCURRENCY=4

# --- Operational hardening ---

# API key required on every request when set. Empty means the app runs OPEN
# — no authentication at all. That is only safe bound to localhost on a
# machine you trust. The app logs a warning at startup while this is empty.
# Send it as an X-API-Key header or ?api_key= query parameter.
API_KEY=

# Max CSV upload size in MB. Fidelity exports are typically under 2MB; the
# cap exists so a malformed or accidental multi-GB upload cannot OOM the
# container.
MAX_UPLOAD_MB=25

# Debug endpoints (/api/debug/*) return raw StockNear payloads and uncached
# contract quotes. They are disabled by default and 404 unless this is true.
ENABLE_DEBUG_ENDPOINTS=false

# Log format: "text" (human-readable, default) or "json" (one object per
# line, for log aggregators).
LOG_FORMAT=text
